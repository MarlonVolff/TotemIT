# ============================================
# CONFIGURAÇÕES DO POSTGRESQL
# ============================================

# Host do banco de dados
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Nome do banco de dados
DB_NAME=totem_equipamentos

# Usuário do PostgreSQL
DB_USER=postgres

# Senha do PostgreSQL
DB_PASSWORD=1234

# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================

# Porta do servidor backend (padrão: 3001)
PORT=3001

# ============================================
# INSTRUÇÕES
# ============================================

# 1. Copie este arquivo para .env
#    cp .env.example .env
#
# 2. Edite o arquivo .env com suas credenciais reais
#
# 3. Certifique-se de que o PostgreSQL está rodando
#
# 4. Execute o script schema.sql para criar as tabelas:
#    psql -U postgres -d totem_equipamentos -f schema.sql
#
# 5. Inicie o servidor:
#    npm run dev
